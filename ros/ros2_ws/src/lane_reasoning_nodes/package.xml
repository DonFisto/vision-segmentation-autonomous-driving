<?xml version="1.0"?>
<package format="3">
  <name>lane_reasoning_nodes</name>
  <version>0.2.0</version>
  <description>
    Lane projection, route-ready rolling mapping, and guidance nodes for the
    ROS2/CARLA autonomy stack.
  </description>

  <maintainer email="daniel.mcvg@gmail.com">Daniel Martinez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>autonomy_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>perception_geometry</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
